extends layout

block content
    a-scene(stats="true" xr-mode-ui="cardboardModeEnabled:true" webxr="requiredFeatures: local-floor;" loaded="true" renderer="logarithmicDepthBuffer: true; antialias: false;")

        //- Céu com cor neutra
        a-sky(color="#C0D8E0")

        //- Ativos do mundo virtual
        a-assets
            //- <a-asset-item id="coluna" src="/assets/base_basic_shaded.glb"></a-asset-item>
            a-asset-item(id="porta" src="3dmodels/porta.glb")
            img(id="entrada" src="images/textos/entrarNoMuseu.png")

        //- Cursor para interação
        a-entity(cursor="rayOrigin: mouse" raycaster="objects: .clickable")

        //- Câmera com checkpoint-controls
        a-entity#camera(movement-controls="controls: checkpoint, keyboard" checkpoint-controls="mode: animate")
        a-entity(camera="active: true" position="0 1.6 0" rotate="0 90 0" cursor="rayOrigin: mouse" wasd-controls look-controls="pointerLockEnabled: false")

        //- Checkpoints
        //FIXME: os cliques não estão funcionando
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -5" radius="0.4" color="#EF2D5E" rotation="-90 0 0")
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -10" radius="0.4" color="#EF2D5E" rotation="-90 0 0")
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -15" radius="0.4" color="#EF2D5E" rotation="-90 0 0")
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -20" radius="0.4" color="#EF2D5E" rotation="-90 0 0")
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -25" radius="0.4" color="#EF2D5E" rotation="-90 0 0")
        a-circle(checkpoint click-component-test class="clickable" position="0 0.15 -30" radius="0.4" color="#EF2D5E" rotation="-90 0 0")

        //- Portas
        //FIXME: por que tinham dois atributos rotation?
        a-entity(gltf-model="#porta" entrar class="clickable porta-2-e" rotation="0 0 0" scale="1.5 1.5 1.5" position="0.5 0.1 -35")
        //FIXME: por que esta porta está duplicada?
        a-entity(gltf-model="#porta" entrar class="clickable porta-2-e" rotation="0 0 0" scale="1.5 1.5 1.5" position="-0.5 0.1 -35")

        //- Grama 
        a-plane(position="0 0 -4" repeat="30 30" rotation="-90 0 0" width="100" height="100" src="images/textureGrama.jpg")

        //- Passarela
        a-plane(position="0 0.1 -10" repeat="1 8" rotation="-90 0 0" width="10" height="50" src="images/passarela.jpg")

        //- Paredes
        a-plane(position="0 5 -35" rotation="0 -180 0" width="45" height="10" src="images/texturaParede.jpg")
        a-plane(position="0 5 -35" rotation="0 0 0" width="45" height="10" src="images/texturaParede.jpg")

